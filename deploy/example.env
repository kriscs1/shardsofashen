# Copy to deploy/.env and fill in.
# The server's domain name (its DNS A record must point at the VPS): Caddy gets the HTTPS certificate for it.
DS_DOMAIN=dragonsword.example.com
# Up to how many players at once
DS_MAX_PLAYERS=5
# open = anyone can make a character; closed = only accounts made with tools/admin.py
DS_REGISTRATION=open
# If set, making a character needs this code (give it to your friends)
DS_INVITE_CODE=
