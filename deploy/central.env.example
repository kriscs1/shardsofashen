# The central server's settings (docker-compose.central.yml). deploy/central-setup.sh writes this as .env and asks
# for the first two; change any of it later, then: docker compose up -d

# Its address. Its DNS A record (and AAAA, if the VM has IPv6) must point at the VM: Caddy gets the HTTPS certificate
# for it. No domain yet? The VM's address as 1-2-3-4.sslip.io works (central-setup.sh offers it).
DS_CENTRAL_DOMAIN=shardsofashen.hallisium.com

# Hallisium accounts that may use /admin (approve servers, find accounts, edit the ads), comma-separated. One with no
# account yet is signed up with the admin code the server's log gives as it starts (docker compose logs central).
DS_CENTRAL_ADMINS=

# Shown on the start screen.
DS_CENTRAL_NAME=Shards of Ashen
DS_CENTRAL_MOTD=

# open: anyone can make an account. closed: nobody new.
DS_REGISTRATION=open
DS_PASSWORD_MIN=8
DS_REGISTER_PER_DAY=3

# Servers listed without waiting for approval (their ids), comma-separated.
DS_CENTRAL_APPROVED=

# The privacy policy (/privacy): who runs it, and an email to write to.
DS_CENTRAL_OPERATOR=
DS_CENTRAL_CONTACT=

# Email: a link to confirm an account's address (it counts only once confirmed), and a forgotten password's code (any SMTP: Namecheap
# Private Email, Brevo, Mailgun, SES, Gmail with an app password). Without it, a forgotten password can't be reset.
# Namecheap Private Email: DS_SMTP_HOST=mail.privateemail.com, port 587 and starttls as below (or 465 and ssl), the
# mailbox's whole address as DS_SMTP_USER, its password as DS_SMTP_PASSWORD. DS_SMTP_FROM is that same mailbox.
# Keep single quotes round anything with a space or a $ in it:
#   DS_SMTP_FROM='Shards of Ashen <shardsofashen@hallisium.com>'
#   DS_SMTP_PASSWORD='the mailbox password'
# Try it, after docker compose up -d: docker compose exec central python -m central.mail you@example.com
DS_SMTP_HOST=
DS_SMTP_PORT=587
DS_SMTP_USER=
DS_SMTP_PASSWORD=
DS_SMTP_FROM=
DS_SMTP_TLS=starttls

# Sign in with Google (README-Server.md says how to get these). Without them the start screen shows no such button.
DS_GOOGLE_CLIENT_ID=
DS_GOOGLE_CLIENT_SECRET=

# Google's ads: AdSense on the start screen in a browser (ca-pub-...), and the Android app's AdMob (ca-app-pub-...~...).
DS_ADSENSE_CLIENT=
DS_ADSENSE_SLOT=
DS_ADMOB_APP=

# How often to look for a new version, in seconds.
DS_UPDATE_SECONDS=300

# Only if the image on GitHub's registry is private: a GitHub user and a token that can read packages.
GHCR_USER=
GHCR_TOKEN=
