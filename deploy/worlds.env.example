# Several public worlds' settings (docker-compose.worlds.yml). Copy to .env beside the compose file and fill in.
# Each world's own settings end in _1, _2, _3; the rest are the same for all of them.

# Each world's address. Their DNS A records (and AAAA, if the VM has IPv6) must point at the VM before you start:
# Caddy gets an HTTPS certificate for each.
DS_DOMAIN_1=one.example.com
DS_DOMAIN_2=two.example.com
DS_DOMAIN_3=three.example.com

# Each world's name, shown in lists of games (changing one takes it off the list till it's approved again).
DS_NAME_1=
DS_NAME_2=
DS_NAME_3=

# Up to how many play at once in each. A world takes about 150 MB with nobody in it, and a tick with five players
# about 1.5 ms of its 50: a 2-CPU, 4 GB VM has room for three.
DS_MAX_PLAYERS_1=15
DS_MAX_PLAYERS_2=15
DS_MAX_PLAYERS_3=15

# open: anyone can make a character. closed: only accounts made with tools/admin.py.
DS_REGISTRATION_1=open
DS_REGISTRATION_2=open
DS_REGISTRATION_3=open

# If set, making a character in that world needs this code (a private world for friends).
DS_INVITE_CODE_1=
DS_INVITE_CODE_2=
DS_INVITE_CODE_3=

# 1: open PvP in that world (players may fight each other outside the arena too).
DS_PVP_1=
DS_PVP_2=
DS_PVP_3=

# Where each world's data is kept: a Docker volume's name, or a folder on the VM (e.g. /srv/shards-of-ashen/one).
DS_DATA_1=world1data
DS_DATA_2=world2data
DS_DATA_3=world3data

# Hallisium accounts whose characters get the Admin button (and /kick, /ban, /mute) in every world, comma-separated:
# the central server (DS_CENTRAL) proves them.
DS_ADMINS=

# The shortest password a new character may have, and how many characters one address may make a day (in each world).
DS_PASSWORD_MIN=8
DS_REGISTER_PER_DAY=3

# The central server (accounts, the list of remote games): with it, players log in once for every world, and each is
# listed for everyone once it's approved on its admin page.
DS_CENTRAL=https://shardsofashen.hallisium.com

# How often to look for a new version of the game, in seconds.
DS_UPDATE_SECONDS=300

# Only if the image on GitHub's registry is private: a GitHub user and a token that can read packages.
GHCR_USER=
GHCR_TOKEN=

# Each day's backup sent off the machine too (a dead disk or a break-in doesn't take the copies with it): a bucket at
# any S3-style store, https://<endpoint>/<bucket>, e.g. https://s3.us-west-004.backblazeb2.com/my-backups, with a key
# that can write but not delete, and a lifecycle rule there to clear old copies (README-Server.md "Backups off the
# machine"). DS_BACKUP_S3_REGION only if the endpoint's name doesn't say it.
DS_BACKUP_S3=
DS_BACKUP_S3_KEY=
DS_BACKUP_S3_SECRET=
DS_BACKUP_S3_REGION=
