# Without Docker: the game folder in /opt/dragonsword, a Python virtualenv in /opt/dragonsword/venv
# (pip install -r requirements.txt; python tools/export_web_assets.py once), and a reverse proxy with HTTPS in front
# (Caddy: "your.domain { reverse_proxy 127.0.0.1:8484 }").
#   sudo cp deploy/dragonsword.service /etc/systemd/system/ && sudo systemctl enable --now dragonsword
[Unit]
Description=Dragon Sword game server
After=network.target

[Service]
User=dragonsword
WorkingDirectory=/opt/dragonsword
Environment=DS_DB=/var/lib/dragonsword/dragonsword.db DS_HOST=127.0.0.1 DS_PORT=8484 DS_MAX_PLAYERS=5
ExecStart=/opt/dragonsword/venv/bin/python -m server
Restart=on-failure
KillSignal=SIGTERM
TimeoutStopSec=20
StateDirectory=dragonsword

[Install]
WantedBy=multi-user.target
