# Optional: copy this to ".env" (in this folder) to change anything. Without it, the defaults below are used.

# The game's image in GitHub's registry
DS_IMAGE=ghcr.io/kriscs1/dragonsword:latest

# Only if the image is private on GitHub: your user name and a token that may read packages
# (https://github.com/settings/tokens/new?scopes=read:packages&description=dragonsword-server)
GHCR_USER=
GHCR_TOKEN=

# The port players connect to: http://<this PC's address>:8080
DS_PORT=8080
# How often to look for an update (seconds)
DS_UPDATE_SECONDS=300

DS_MAX_PLAYERS=5
# open = anyone who can reach the server can make a character; closed = only accounts made with tools/admin.py
DS_REGISTRATION=open
# If set, making a character needs this code
DS_INVITE_CODE=
