# The central server's settings (docker-compose.central.yml). deploy/central-setup.sh writes this as .env and asks
# for the first two; change any of it later, then: docker compose up -d

# Its address. Its DNS A record (and AAAA, if the VM has IPv6) must point at the VM: Caddy gets the HTTPS certificate
# for it. No domain yet? The VM's address as 1-2-3-4.sslip.io works (central-setup.sh offers it).
DS_CENTRAL_DOMAIN=soa.hallisium.com

# Shards accounts that may use /admin (approve servers, find accounts, edit the ads), comma-separated. One with no
# account yet is signed up with the admin code the server's log gives as it starts (docker compose logs central).
DS_CENTRAL_ADMINS=

# Shown on the start screen.
DS_CENTRAL_NAME=Shards of Ashen
DS_CENTRAL_MOTD=

# open: anyone can make an account. closed: nobody new.
DS_REGISTRATION=open
DS_PASSWORD_MIN=8
DS_REGISTER_PER_DAY=3

# Servers listed without waiting for approval (their ids), comma-separated.
DS_CENTRAL_APPROVED=

# The privacy policy (/privacy): who runs it, and an email to write to.
DS_CENTRAL_OPERATOR=
DS_CENTRAL_CONTACT=

# Email for a forgotten password (any SMTP: Brevo, Mailgun, SES, Gmail with an app password). Without it, the
# recovery code is the only way back in.
DS_SMTP_HOST=
DS_SMTP_PORT=587
DS_SMTP_USER=
DS_SMTP_PASSWORD=
DS_SMTP_FROM=
DS_SMTP_TLS=starttls

# Google's ads: AdSense on the start screen in a browser (ca-pub-...), and the Android app's AdMob (ca-app-pub-...~...).
DS_ADSENSE_CLIENT=
DS_ADSENSE_SLOT=
DS_ADMOB_APP=

# How often to look for a new version, in seconds.
DS_UPDATE_SECONDS=300

# Only if the image on GitHub's registry is private: a GitHub user and a token that can read packages.
GHCR_USER=
GHCR_TOKEN=
