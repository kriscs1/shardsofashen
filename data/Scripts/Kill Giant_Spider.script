// Run when one dies: counts it for the quest RangerQuest (stage 3). Generated by build_regions.py
01	Get.Value	ATTRIBUTE	RangerQuest	Variable.1$
02	>Conditional	$Variable.1=3	13
03	Get.Value	ATTRIBUTE	WildSpidersSlain	Variable.2$
04	>Conditional	$Variable.2<5	13
05	Update.Attribute	WildSpidersSlain	+1
06	Get.Value	CALCULATION	$Variable.2+1	Variable.2$
07	>Conditional	$Variable.2<5	10
08	Display.Message	Yellow	Giant spiders slain for Ranger Ash: $Variable.2 of 5.
09	End
10	Quest.Note.Done	RangerQuest	Slay five giant spiders there.
11	Quest.Note	RangerQuest	Return to Ranger Ash in Oakhollow.
12	Display.Message	Yellow	Five spiders! Return to Ranger Ash in Oakhollow.
13	End
