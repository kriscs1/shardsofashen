# Copy this to ".env" (in this folder) and fill it in.

# The game's image in GitHub's registry: ghcr.io/<your GitHub user name, in lower case>/dragonsword:latest
DS_IMAGE=ghcr.io/yourname/dragonsword:latest

# Your GitHub user name, and a token that may read your packages, for downloading the game (and its updates):
# github.com > your picture > Settings > Developer settings > Personal access tokens > Tokens (classic) >
# Generate new token (classic): no expiry (or a long one), tick only "read:packages"
GHCR_USER=yourname
GHCR_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The port players connect to: http://<this PC's address>:8080
DS_PORT=8080
# How often to look for an update (seconds)
DS_UPDATE_SECONDS=300

DS_MAX_PLAYERS=5
# open = anyone who can reach the server can make a character; closed = only accounts made with tools/admin.py
DS_REGISTRATION=open
# If set, making a character needs this code
DS_INVITE_CODE=
