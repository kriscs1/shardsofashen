# A public server's settings (docker-compose.cloud.yml). Copy to .env beside the compose file and fill in.

# The server's address. Its DNS A record (and AAAA, if the VM has IPv6) must point at the VM before you start:
# Caddy gets the HTTPS certificate for it.
DS_DOMAIN=play.example.com

# Shards accounts whose characters get the Admin button (and /kick, /ban, /mute), comma-separated: the central
# server (DS_CENTRAL) proves them. Without one: python tools/admin.py admin <Name> on.
DS_ADMINS=

# Up to how many play at once. A 2-CPU VM keeps 20-30 smooth.
DS_MAX_PLAYERS=20

# open: anyone can make a character on the login screen. closed: only accounts made with tools/admin.py.
DS_REGISTRATION=open

# If set, making a character needs this code (a private server for friends).
DS_INVITE_CODE=

# The shortest password a new character may have, and how many characters one address may make a day.
DS_PASSWORD_MIN=8
DS_REGISTER_PER_DAY=3

# The central server (accounts, the list of remote games): with it, players log in once for every game, and this
# server is listed for everyone (DS_PUBLIC=1; 0: not listed, joined by its address only).
DS_CENTRAL=
DS_PUBLIC=1

# The game's name, shown in lists of games.
DS_NAME=

# Where the data is kept: a Docker volume's name (gamedata) or a folder on the VM (e.g. /srv/shards-of-ashen).
DS_DATA=gamedata

# How often to look for a new version of the game, in seconds.
DS_UPDATE_SECONDS=300

# Only if the image on GitHub's registry is private: a GitHub user and a token that can read packages.
GHCR_USER=
GHCR_TOKEN=
