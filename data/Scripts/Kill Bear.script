// Run when one dies: counts it for the quest DruidQuest (stage 2). Generated by build_regions.py
01	Get.Value	ATTRIBUTE	DruidQuest	Variable.1$
02	>Conditional	$Variable.1=2	13
03	Get.Value	ATTRIBUTE	BlightBears	Variable.2$
04	>Conditional	$Variable.2<4	13
05	Update.Attribute	BlightBears	+1
06	Get.Value	CALCULATION	$Variable.2+1	Variable.2$
07	>Conditional	$Variable.2<4	10
08	Display.Message	Yellow	Maddened bears slain for the Druid: $Variable.2 of 4.
09	End
10	Update.Attribute	DruidQuest	=3
11	Quest.Note.Done	DruidQuest	Slay four maddened bears in the Elderwood.
12	Display.Message	Yellow	Four bears! Return to the Druid in Thornwick.
13	End
